# Copy this file to .env and fill values for local development only.

# Backend
BACKEND_PORT=8080
JAVA_OPTS=
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/smartiq
SPRING_DATASOURCE_USERNAME=smartiq
SPRING_DATASOURCE_PASSWORD=smartiq
SMARTIQ_IMPORT_ENABLED=true
SMARTIQ_IMPORT_PATH=../data/smart10
SMARTIQ_POOL_ENABLED=true
MIN_BANK_SIZE=1000
POOL_LOW_WATERMARK=800
POOL_TARGET=1200
SMARTIQ_BLOCK_ON_LOW_BANK=false
SMARTIQ_TRIGGER_PIPELINE_ON_LOW_BANK=false
SMARTIQ_PIPELINE_COMMAND=npm run pipeline:cards
SMARTIQ_SESSION_DEDUP_ENABLED=true
SMARTIQ_SESSION_TTL_MINUTES=120
SMARTIQ_SESSION_MAX=50000
SMARTIQ_GAME_SESSION_RETENTION_MINUTES=180
SMARTIQ_GAME_SESSION_MAX=50000
SMARTIQ_ROOM_RETENTION_MINUTES=180
SMARTIQ_ROOM_MAX=20000
SMARTIQ_RATE_LIMIT_ENABLED=true
SMARTIQ_RATE_LIMIT_WINDOW_SECONDS=60
SMARTIQ_RATE_LIMIT_TRUST_FORWARDED_FOR=false
SMARTIQ_RATE_LIMIT_COUNTER_MAX=50000
SMARTIQ_RATE_LIMIT_WS_ROOMS_PER_MINUTE=120
SMARTIQ_RATE_LIMIT_CARDS_NEXT_PER_MINUTE=120
SMARTIQ_RATE_LIMIT_SESSION_ANSWER_PER_MINUTE=180
SMARTIQ_RATE_LIMIT_GAME_PER_MINUTE=240
SMARTIQ_RATE_LIMIT_ROOMS_PER_MINUTE=120
SMARTIQ_CORS_ALLOWED_ORIGIN_PUBLIC=https://smartiq.vercel.app
SMARTIQ_INTERNAL_ACCESS_ENABLED=false
SMARTIQ_INTERNAL_API_KEY_HEADER=X-Internal-Api-Key
SMARTIQ_INTERNAL_API_KEY=
SPRING_PROFILES_ACTIVE=dev

# Frontend
FRONTEND_PORT=3000
API_BASE_URL=http://localhost:8080
VITE_API_BASE_URL=http://localhost:8080
BACKEND_PUBLIC_URL=https://smartiq-backend.onrender.com
FRONTEND_PUBLIC_URL=https://smartiq.vercel.app
BACKEND_URL=https://smartiq-backend.onrender.com
VITE_BACKEND_URL=https://smartiq-backend.onrender.com

# Data/content pipeline
RAW_DATA_PATH=./data/raw
# Legacy variable name kept for compatibility; canonical dataset path is data/smart10.
CLEAN_DATA_PATH=./data/smart10
MAX_GENERATION_PER_RUN=10000
MAX_DAILY_GENERATION=10000
OPENAI_API_KEY=
