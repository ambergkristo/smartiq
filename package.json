{
  "name": "smartiq",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "postinstall": "npm --prefix frontend ci",
    "dev:backend": "mvn -q -f backend/pom.xml spring-boot:run -Dspring-boot.run.profiles=local",
    "dev:backend:8081": "mvn -q -f backend/pom.xml spring-boot:run -Dspring-boot.run.profiles=local -Dspring-boot.run.arguments=--server.port=8081",
    "dev:backend:smoke": "mvn -q -f backend/pom.xml spring-boot:run -Dspring-boot.run.profiles=dev -Dspring-boot.run.arguments=--server.port=8081",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:frontend:5173": "npm --prefix frontend run dev -- --port 5173",
    "dev:all": "concurrently -n backend,frontend -c cyan,green \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:smoke": "concurrently -n backend,frontend -c cyan,green \"npm run dev:backend:smoke\" \"npm run dev:frontend:5173\"",
    "generate:cards": "node tools/generate-cards.js",
    "review:cards": "node tools/review-cards.js",
    "review:summary": "node tools/review-summary.js",
    "validate:cards": "node tools/validate_cards_v2.js data/smart10/cards.en.json --max-warnings=0",
    "validate:cards:et": "node tools/validate_cards_v2.js data/smart10/cards.et.json --max-warnings=0",
    "validate:no-bom:docs": "node tools/validate_no_bom_docs.js docs",
    "validate:masterplan:refs": "node tools/validate_masterplan_reference.js",
    "validate:flyway:migrations": "node tools/validate_flyway_migrations.js",
    "validate:beta:alerts": "node tools/validate_beta_alert_rules.js",
    "validate:locale-packs": "node tools/validate_locale_packs.js data/smart10",
    "audit:locale:coverage": "node tools/audit_locale_coverage.js data/smart10 --required=en,et --min-per-combo=30",
    "score:cards:quality": "node tools/score_cards_quality.js data/smart10/cards.en.json",
    "score:cards:quality:et": "node tools/score_cards_quality.js data/smart10/cards.et.json",
    "score:cards:quality:ci": "node tools/score_cards_quality.js data/smart10/cards.en.json --fail-threshold=0.80",
    "score:cards:quality:ci:et": "node tools/score_cards_quality.js data/smart10/cards.et.json --fail-threshold=0.80",
    "score:cards:semantic": "node tools/score_cards_semantic.js data/smart10/cards.en.json",
    "score:cards:semantic:et": "node tools/score_cards_semantic.js data/smart10/cards.et.json",
    "score:cards:semantic:ci": "node tools/score_cards_semantic.js data/smart10/cards.en.json --fail-threshold=0.70",
    "score:cards:semantic:ci:et": "node tools/score_cards_semantic.js data/smart10/cards.et.json --fail-threshold=0.70",
    "report:cards:semantic:budget": "node tools/report_semantic_warning_budget.js --max-warnings=80",
    "report:cards:semantic:parity": "node tools/report_semantic_locale_parity.js --min-category-score=NUMBER:0.90,COLOR:0.95 --max-short-option-ratio=NUMBER:0.40,COLOR:0.10 --max-locale-score-gap=0.02 --max-locale-warning-gap=10",
    "report:cards:semantic:parity:ci": "node tools/report_semantic_locale_parity.js --min-category-score=NUMBER:0.90,COLOR:0.95 --max-short-option-ratio=NUMBER:0.40,COLOR:0.10 --max-locale-score-gap=0.02 --max-locale-warning-gap=10 --fail-on-exceed",
    "report:branches:consolidation": "node tools/report_branch_consolidation.js --repo ambergkristo/smartiq --base origin/main --max-branches=30 --output docs/branch-consolidation-audit-latest.md",
    "report:branches:consolidation:full": "node tools/report_branch_consolidation.js --repo ambergkristo/smartiq --base origin/main --output docs/branch-consolidation-audit-latest.md",
    "report:et:quality": "node tools/generate_et_quality_report.js",
    "validate:cards:legacy": "node tools/validate-cards.js data/smart10/cards.en.json",
    "test:golden": "node tools/validate-cards.js data/smart10/golden/golden.dataset.json",
    "pipeline:cards": "node tools/build-content-pipeline.js",
    "load:test": "node tools/load-test.js",
    "smoke:test": "node tools/smoke-test.js",
    "smoke:postdeploy": "node tools/post-deploy-smoke.js",
    "smoke:test:et": "node -e \"process.env.SMOKE_LANGUAGE='et'; require('./tools/smoke-test.js')\"",
    "report:et:runtime": "node tools/generate_et_runtime_smoke_report.js",
    "report:beta:summary": "node tools/generate_beta_summary_report.js",
    "gate:et:release": "node tools/run_et_release_gate.js",
    "gate:quick": "node tools/run_local_verification_gate.js",
    "gate:local": "node tools/run_local_verification_gate.js",
    "release:check": "node tools/run_release_readiness_check.js",
    "test:contracts:backend": "mvn -q -f backend/pom.xml -Dtest=GameSessionSnapshotContractTest,GameSessionControllerTest,RoomControllerTest,RoomServiceTest test",
    "test:contracts:frontend": "npm --prefix frontend run test -- --run src/App.server-mode.test.jsx src/api.test.js",
    "test:contracts": "npm run test:contracts:backend && npm run test:contracts:frontend",
    "validate:deploy-env": "node tools/validate-deploy-env.js",
    "stability:gate": "node tools/stability-gate.js",
    "verify:runtime:deck": "node scripts/verify_runtime_deck.js",
    "report:runtime:health": "node scripts/runtime_health_report.js"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
